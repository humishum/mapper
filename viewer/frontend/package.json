{
  "name": "mapper-viewer",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:api": "openapi-typescript ../../schemas/openapi.v1.json -o src/api/openapi.ts",
    "benchmark": "npm --prefix ../../benchmarks/viewer test",
    "benchmark:list": "npm --prefix ../../benchmarks/viewer run list",
    "benchmark:validate": "npm --prefix ../../benchmarks/viewer run validate",
    "benchmark:serve": "npm run build && npm run preview -- --host 127.0.0.1 --port 5173 --strictPort",
    "preview": "vite preview"
  },
  "dependencies": {
    "@giro3d/giro3d": "2.0.3",
    "ajv": "8.17.1",
    "hyparquet": "1.26.2",
    "ol": "10.8.0",
    "proj4": "2.19.10",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "jsdom": "27.2.0",
    "openapi-typescript": "7.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.1",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
